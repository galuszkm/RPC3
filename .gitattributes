# Store text files with LF in the repo and check them out with LF on every OS,
# so Windows clones don't produce CRLF diffs.
* text=auto eol=lf

# Windows-only scripts need CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary files: never touch line endings or diff them as text
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.rsp  binary
*.woff  binary
*.woff2 binary
